#!/bin/bash

# chezmoi runs scripts with a bare PATH, so locate brew ourselves.
for brew_path in "/opt/homebrew/bin/brew" "/home/linuxbrew/.linuxbrew/bin/brew" "/usr/local/bin/brew"; do
    if [ -x "$brew_path" ]; then
        eval "$("$brew_path" shellenv)"
        break
    fi
done

{{ if eq .chezmoi.os "linux" -}}
brew bundle --file=/dev/stdin <<EOF
brew "bat"
brew "chezmoi"
brew "eza"
brew "fd"
brew "fzf"
brew "gh"
brew "micro"
brew "ripgrep"
brew "starship"
brew "thefuck"
brew "tlrc"
brew "uv"
brew "yazi"
brew "zoxide"
EOF
{{ else if eq .chezmoi.os "darwin" -}}
brew bundle --file={{ joinPath .chezmoi.homeDir ".Brewfile" }}
{{ end -}}
